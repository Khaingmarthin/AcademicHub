# ==============================================================================
# Environment and Secrets
# Ignore environment variables, API keys, and sensitive certificate files
# ==============================================================================
.env
.env.*
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx

# ==============================================================================
# Packages and Dependencies
# Ignore downloaded dependency directories for various package managers
# ==============================================================================
node_modules/
vendor/
venv/
.venv/
env/

# ==============================================================================
# Build, Output, and Compiled Files
# Ignore build artifacts, output directories, and compiled binaries
# ==============================================================================
dist/
build/
bin/
out/
*.exe
*.dll
*.so
*.dylib
*.pyc
__pycache__/

# ==============================================================================
# IDE, OS, and Editor Configurations
# Ignore system-specific or editor-specific configuration files
# ==============================================================================
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# ==============================================================================
# Logs and Temporary Runtime Files
# Ignore log outputs, debug files, and temporary directories
# ==============================================================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
tmp/
temp/
/scratch/
